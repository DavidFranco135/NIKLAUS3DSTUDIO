{
  "functions": [
    {
      "source": "apps/api",
      "codebase": "api",
      "runtime": "python312",
      "ignore": [
        ".venv",
        ".pytest_cache",
        ".ruff_cache",
        ".mypy_cache",
        "__pycache__",
        "*.egg-info",
        "tests",
        "migrations",
        "Dockerfile",
        ".dockerignore"
      ]
    }
  ],
  "firestore": {
    "rules": "infra/firebase/firestore.rules",
    "indexes": "infra/firebase/firestore.indexes.json"
  },
  "emulators": {
    "functions": {
      "port": 5001
    },
    "firestore": {
      "port": 8080
    },
    "ui": {
      "enabled": true
    }
  }
}
