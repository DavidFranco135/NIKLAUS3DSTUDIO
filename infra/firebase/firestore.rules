rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Placeholder: all access denied by default. The API (Cloud Functions,
    // using the Admin SDK) bypasses these rules entirely — they only matter
    // if a client ever talks to Firestore directly, which this app doesn't
    // do today. Tightened further if/when that changes.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
